# Copy this file to .env.local and fill in your real values.
# Get these from your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Get a free key at themoviedb.org -> Settings -> API.
# Used server-side only to auto-fill movie posters when an admin adds a new
# adaptation without pasting an image URL. Leave blank to skip auto-fill.
TMDB_API_KEY=
